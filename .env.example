# ==============================================================================
# Environment Configuration for Data Tracking
# Copy this file to .env and adjust DATA_ROOT to match your local/HPC mount point.
#
# IMPORTANT: .env is gitignored and should never be committed.
# ==============================================================================

# Base directory where external raw datasets and upstream checksum files reside.
# Example for macOS:
# DATA_ROOT=/Volumes/LabStorage/raw_datasets
#
# Example for Linux / HPC cluster:
# DATA_ROOT=/mnt/scratch/bioinfo_core/raw_datasets
#
# Example for local development / testing:
DATA_ROOT=/path/to/external/raw_datasets

# Optional: Local symlink directory inside this repository (defaults to 'raw_data')
# - Greenfield projects: leave default 'raw_data' (or SYMLINK_DIR=raw_data)
# - Existing projects with scattered symlinks: set to '.' for repository-relative paths
# SYMLINK_DIR=.

# ==============================================================================
# Multi-Mount / Named Storage Roots (Option 1)
# ==============================================================================
# When raw data or reference genomes reside across multiple physical drives or
# distinct cluster mounts, define additional named roots ending in _ROOT:
#
# REF_ROOT=/Volumes/InstitutionalReferences/genomes
# ARCHIVE_ROOT=/mnt/tape_archive/project_x
# COLLAB_ROOT=/Volumes/CollaboratorDrive
#
# In local_pointers.tsv, reference these using ROOT_NAME:path syntax:
#   references/hg38.fa    REF_ROOT:genomes/hg38.fa    REF_ROOT:genomes/checksums.sha256    <hash>
# Paths without a prefix automatically default to DATA_ROOT.

