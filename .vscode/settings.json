{
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/raw_data": false,
    "**/work": true,
    "**/.nextflow": true,
    "**/.snakemake": true,
    "**/.test_tmp": true
  },
  "search.exclude": {
    "**/raw_data/**": true,
    "**/work/**": true,
