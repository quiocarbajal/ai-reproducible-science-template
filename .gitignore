# ==============================================================================
# 1. RAW & EXTERNAL DATA (Symlinks & Large Genomic Files)
#    All raw data is accessed via external pointers defined in local_pointers.tsv.
# ==============================================================================
raw_data/
data/raw/
data/external/

# Large genomic binary & index formats
*.bam
*.bai
*.sam
.*bw
*.bedgraph
*.bedpe
*.cram
*.crai
*.fastq.gz
*.fq.gz
*.vcf.gz
*.tbi
*.bed.gz
*.tar.gz
*.zip

# R & Python serialized data binaries & matrices
*.rds
*.RData
*.rda
*.qs
*.qs2
*.pkl
*.pickle
*.joblib
*.parquet
*.feather
*.arrow
*.npy
*.npz
*.h5ad
*.h5
*.hdf5

# ==============================================================================
# 2. PIPELINE INTERMEDIATES & DERIVED ARTIFACTS
#    Generated state is reproducible from: Raw Data + Code + Software Environment
# ==============================================================================
work/
.nextflow/
.nextflow.log*
.snakemake/
.cache/
tmp/
scratch/
.test_tmp/
results/
output/
logs/
*.log
.staging/

# ==============================================================================
# 3. ENVIRONMENT & SECRETS
# ==============================================================================
.env
.env.*
!.env.example

# ==============================================================================
# 4. OS & IDE ARTIFACTS
# ==============================================================================
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*~
*.Rhistory
.Rhistory
__pycache__/
*.pyc

# Local personal utilities & doc rendering
scripts/sync_to_dropbox.sh
scripts/render_markdown_to_html.py
*.html

# ==============================================================================
# 5. WHITELIST / EXCEPTIONS (Track Specific Excluded Files)
#    To track a specific small binary or intermediate file in Git without
#    forcing (`git add -f`), negate the ignore rule with a leading `!`.
# ==============================================================================
# Examples:
# !results/gold_standard_reference.bam
# !data/annotation_lookup_table.rds
# !models/baseline_weights.pkl
